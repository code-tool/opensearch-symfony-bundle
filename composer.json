{
  "name": "code-tool/opensearch-bundle",
  "description": "Symfony bundle for managing OpenSearch indexes with YAML configuration support",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "symfony",
    "bundle",
    "opensearch",
    "search",
    "index"
  ],
  "authors": [
    {
      "name": "Taras Hirnyk"
    }
  ],
  "require": {
    "php": ">=8.4",
    "nyholm/psr7": "^1.8",
    "opensearch-project/opensearch-php": "^2.0",
    "symfony/config": "^6.0|^7.0|^8.0",
    "symfony/console": "^6.0|^7.0|^8.0",
    "symfony/dependency-injection": "^6.0|^7.0|^8.0",
    "symfony/http-client": "^7.3|^8.0",
    "symfony/http-kernel": "^6.0|^7.0|^8.0",
    "symfony/yaml": "^6.0|^7.0|^8.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^10.0",
    "symfony/phpunit-bridge": "^6.0|^7.0|^8.0",
    "symfony/var-dumper": "^6.0|^7.0|^8.0",
    "phpstan/phpstan": "^1.10",
    "symfony/framework-bundle": "^6.0|^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "CodeTool\\OpenSearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodeTool\\OpenSearch\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true
    }
  },
  "extra": {
    "symfony": {
      "require": "^6.0|^7.0|^8.0"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse src --level=8"
  }
}
